{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "setup_python_env",
            "type": "shell",
            "command": "\"${input:isaac_path}/python.sh\" \"${workspaceFolder}/.vscode/tools/setup_vscode.py\" --isaac_path \"${input:isaac_path}\""
        }
    ],
    "inputs": [
        {
            "id": "isaac_path",
            "description": "Absolute path to the Isaac Sim installation.",
            "default": "/isaac-sim",
            "type": "promptString"
        }
    ]
}
